# HTTPS Proxy Configuration
#
server
{
    server_name             mail.example.com;

    # The listen address prefix is empty (all addresses, certificate chosen via SNI) unless
    # zimbraReverseProxySNIEnabled is FALSE, in which case the deprecated zimbraVirtualIPAddress
    # of the domain is used. IP-based virtual hosting is deprecated in favour of SNI.
    #listen                    9071 ssl;
    listen                  9071 ssl;
    #listen                  9071 ssl;

    ssl_protocols            TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache       shared:SSL:10m;
    ssl_session_timeout     600;
    ssl_ciphers             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_ecdh_curve          auto;
    ssl_certificate         /opt/zextras/conf/domaincerts/example.com.crt;
    ssl_certificate_key     /opt/zextras/conf/domaincerts/example.com.key;
    proxy_ssl_protocols            TLSv1.2 TLSv1.3;
    proxy_ssl_ciphers             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_dhparam             /opt/zextras/conf/dhparam.pem;

    # no maximum limit imposed on the size of the request body
    client_max_body_size    0;

    # response headers
    add_header Expect-CT max-age=86400;
    add_header Permissions-Policy "geolocation=(self), microphone=(self)";
    add_header Referrer-Policy "same-origin";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload";
    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "sameorigin";
    add_header X-Robots-Tag "noindex, nofollow";
    add_header X-XSS-Protection "1; mode=block";
    add_header Content-Security-Policy "default-src 'self' data: blob: cid:; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.zextras.tools *.jsdelivr.net; style-src * 'unsafe-inline'; img-src * data: blob: cid:; font-src * data:; connect-src 'self' *.zextras.tools *.jsdelivr.net; media-src * blob: data: cid:; object-src 'self'; child-src 'self' blob: data: cid:; frame-src 'self' blob: data: cid:; frame-ancestors 'self'; form-action 'self';";

    # Block subresource requests flagged by $untrusted_subresource (nginx.conf.web)
    if ($untrusted_subresource) {
        return 403;
    }

    location /
    {
        # Proxy to Zimbra adminclient Upstream
        proxy_pass          https://zimbra_adminclient;

        # For audit
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # For admin console, the proxied request must have 7071
        # in Host header. Otherwise, the web client page or error might be returned.
        #
        set $relhost $host;
        if ($host = '') {
            set $relhost $server_addr;
        }
        proxy_set_header Host            $relhost:7071;

        # Avoid leak the 7071 in the response such as 302 redirection
        #
        proxy_redirect https://$relhost:7071/ https://$relhost:9071/;
    }

    location ^~ /service
    {
        # Proxy to Zimbra Upstream
        proxy_pass          https://zimbra_admin;

        # For audit
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # For admin console, the proxied request must have 7071
        # in Host header. Otherwise, the web client page or error might be returned.
        #
        set $relhost $host;
        if ($host = '') {
            set $relhost $server_addr;
        }
        proxy_set_header Host            $relhost:7071;

        # Avoid leak the 7071 in the response such as 302 redirection
        #
        proxy_redirect https://$relhost:7071/ https://$relhost:9071/;
    }
}


