stream {
  upstream message-dispatcher-xmpp
    {
        server 127.78.0.1:20005 fail_timeout=10s;
    }

  upstream address-book
    {
        server 127.78.0.1:20006 fail_timeout=10s;
    }

   include /opt/zextras/conf/nginx/includes/nginx.conf.stream.addressBook;
   include /opt/zextras/conf/nginx/includes/nginx.conf.stream.message.dispatcher.xmpp;
}
