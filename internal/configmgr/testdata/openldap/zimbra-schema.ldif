#
# Reduced subset of the Carbonio LDAP schema (carbonio.ldif, generated by
# AttributeManagerUtil): the attribute types and object classes the configd
# loaders read, with the real names and OIDs. Loaded into slapd-config by
# the integration test container.
dn: cn=zimbra,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: zimbra
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.19
  NAME ( 'zimbraDomainName' )
  DESC 'name of the domain'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.212
  NAME ( 'zimbraDomainType' )
  DESC 'should be one of: local, alias'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{32}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.1
  NAME ( 'zimbraId' )
  DESC 'Unique identifier for an entry'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.3023
  NAME ( 'zimbraLDAPSchemaVersion' )
  DESC 'LDAP schema version for the system.'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.308
  NAME ( 'zimbraMailMode' )
  DESC 'whether to run HTTP or HTTPS or both/mixed mode or redirect mode.  See also related attributes zimbraMailPort and zimbraMailSSLPort'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{32}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.166
  NAME ( 'zimbraMailSSLPort' )
  DESC 'SSL port for end-user UI'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  EQUALITY integerMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.1115
  NAME ( 'zimbraMilterBindAddress' )
  DESC 'interface address on which milter server should listen; if not specified, binds to 127.0.0.1'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{128}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.1114
  NAME ( 'zimbraMilterBindPort' )
  DESC 'port number on which milter server should listen'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  EQUALITY integerMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.1116
  NAME ( 'zimbraMilterServerEnabled' )
  DESC 'whether milter server is enabled for a given server'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  EQUALITY booleanMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.198
  NAME ( 'zimbraMtaMaxMessageSize' )
  DESC 'Maximum total size of a mail message. Enforced in mailbox server and also used as value for postconf message_size_limit.  0 means "no limit"'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  EQUALITY integerMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.311
  NAME ( 'zimbraMtaMyNetworks' )
  DESC 'value of postfix mynetworks'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{10240}
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreSubstringsMatch)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.226
  NAME ( 'zimbraMtaRestriction' )
  DESC 'smtpd_recipient_restrictions used to reject email in various scenarios'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{2048}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.504
  NAME ( 'zimbraReverseProxyLookupTarget' )
  DESC 'whether this server is a valid upstream and needs to be included in the upstream config of the reverse proxy'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  EQUALITY booleanMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.639
  NAME ( 'zimbraSSLExcludeCipherSuites' )
  DESC 'exact name or regular expression of cipher suites to exclude'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.220
  NAME ( 'zimbraServiceEnabled' )
  DESC 'services that are enabled on this server'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.65
  NAME ( 'zimbraServiceHostname' )
  DESC 'public hostname of the host'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.352
  NAME ( 'zimbraVirtualHostname' )
  DESC 'An alias for this domain, used to determine default login domain based on URL client is visiting'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch)
olcAttributeTypes: ( 1.3.6.1.4.1.19348.2.1.562
  NAME ( 'zimbraVirtualIPAddress' )
  DESC 'Deprecated since: 26.9.0.  Legacy IP-based virtual hosting (Virtual IP) inherited from Zimbra is deprecated per CO-3691 and no longer supported. It only affects protocols proxied by nginx, cannot cover SMTP, and is ignored when SNI is enabled (the default). Use name-based virtual hosts (zimbraVirtualHostname) with SNI; multi-certificate support for IMAP/POP/SMTP will be delivered through SNI on nginx and Postfix.  Orig desc: Virtual IP address for this domain, used to determine domain based on an IP address and have IP-based virtual hosts for the proxy. Consider using zimbraReverseProxySNIEnabled instead when using SNI capable clients'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256}
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch)
olcObjectClasses: ( 1.3.6.1.4.1.19348.2.2.9 NAME 'zimbraGlobalConfig'
  SUP top AUXILIARY
  MUST ( zimbraLDAPSchemaVersion )
  MAY ( zimbraMailMode $ zimbraMailSSLPort $ zimbraMilterBindPort $ zimbraMilterServerEnabled $ zimbraMtaMaxMessageSize $ zimbraMtaMyNetworks $ zimbraMtaRestriction $ zimbraSSLExcludeCipherSuites $ zimbraServiceEnabled ) )
olcObjectClasses: ( 1.3.6.1.4.1.19348.2.2.8 NAME 'zimbraServer'
  SUP top STRUCTURAL
  MUST ( cn $ zimbraId )
  MAY ( zimbraMailMode $ zimbraMailSSLPort $ zimbraMilterBindAddress $ zimbraMilterBindPort $ zimbraMilterServerEnabled $ zimbraMtaMaxMessageSize $ zimbraMtaMyNetworks $ zimbraMtaRestriction $ zimbraReverseProxyLookupTarget $ zimbraSSLExcludeCipherSuites $ zimbraServiceEnabled $ zimbraServiceHostname ) )
olcObjectClasses: ( 1.3.6.1.4.1.19348.2.2.4 NAME 'zimbraDomain'
  SUP top AUXILIARY
  MUST ( zimbraDomainName $ zimbraDomainType $ zimbraId )
  MAY ( zimbraVirtualHostname $ zimbraVirtualIPAddress ) )
