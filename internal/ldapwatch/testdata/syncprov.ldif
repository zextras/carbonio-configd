#
# slapd-config additions that give the test directory what a multi-master or
# replica Carbonio provider has: the syncprov overlay on the data database, so
# slapd advertises and serves the RFC 4533 content-sync control.
dn: cn=module{1},cn=config
objectClass: olcModuleList
cn: module{1}
olcModulePath: /usr/lib/openldap
olcModuleLoad: syncprov.so

dn: olcOverlay={0}syncprov,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcSyncProvConfig
olcOverlay: {0}syncprov
