[Unit]
Description=Carbonio Config Daemon
Documentation=https://docs.zextras.com
PartOf=carbonio-appserver.target carbonio-directory-server.target carbonio-mta.target carbonio-proxy.target

# Ensure network and LDAP are available
After=network-online.target carbonio-openldap.service
Wants=network-online.target

[Service]
Type=notify
User=zextras
EnvironmentFile=-/opt/zextras/data/systemd.env
ExecStartPre=/opt/zextras/bin/systemd-envscript
# Bounded wait for ldap_url (same resolution and TLS rules as the daemon); returns at
# once when no LDAP URL is configured, fails after 120 s.
ExecStartPre=/opt/zextras/bin/configd ldap wait --timeout 120s
ExecStart=/opt/zextras/bin/configd
ExecReload=/bin/kill -HUP $MAINPID
NotifyAccess=main

# Watchdog: configd pings every WatchdogSec/2; systemd restarts it if silent.
# The watchdog only activates after READY=1, so slow startup is not penalised.
WatchdogSec=120

# Startup may take long on first run (LDAP queries, config rewrites).
# configd sends READY=1 after the first successful loop iteration.
TimeoutStartSec=300
TimeoutStopSec=10
# KillMode=mixed: in systemd mode every service is a unit of its own, so this
# cgroup holds only the daemon and its short-lived helpers (zmprov, postconf,
# systemctl): SIGTERM to the daemon, then SIGKILL to any helper still around.
# Legacy mode (services started by the daemon, no carbonio target enabled) is not
# supported by this unit; see legacy-mode.conf, which sets KillMode=process.
KillMode=mixed
KillSignal=SIGTERM

# Restart policy
Restart=on-failure
RestartSec=3
StartLimitInterval=300
StartLimitBurst=5

# Resource limits
MemoryMax=512M
MemoryHigh=384M
CPUQuota=80%
TasksMax=256

# OOM protection (negative = less likely to be killed, range: -1000 to 1000)
OOMScoreAdjust=-500

# The sandbox below assumes systemd mode: the daemon calls systemctl (polkit) and
# never needs sudo or file capabilities. A host that runs the daemon in legacy mode
# needs the opt-in drop-in /usr/share/carbonio-configd/systemd/legacy-mode.conf
# (docs/systemd.md, "Legacy mode on a systemd host"); the daemon logs a WARN at
# startup when it finds itself in that situation under this unit.

# ── Security: Filesystem ──────────────────────────────────────────────
ProtectSystem=strict
# common/conf (Postfix configuration) is root-owned and not writable here: changes go
# through the staging dir under data/ and the carbonio-postfix-conf.service helper.
ReadWritePaths=-/opt/zextras/conf -/opt/zextras/log -/opt/zextras/data -/run/carbonio
ProtectHome=yes
PrivateTmp=yes
UMask=0027

# ── Security: Process isolation ───────────────────────────────────────
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# ── Security: Privilege restrictions ──────────────────────────────────
# sudo is only used by legacy (non-systemd) and CustomStart paths, which the
# daemon never takes in systemd mode (systemctl via polkit instead). Postfix
# configuration changes also go through systemctl: it stages them and starts
# carbonio-postfix-conf.service, which applies them as root.
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

# Drop all capabilities — configd runs as unprivileged zextras user
# and child processes (systemctl, postconf, zm*ctl) communicate via
# D-Bus / pipes, not kernel capabilities.
CapabilityBoundingSet=

# ── Security: Namespace restrictions ──────────────────────────────────
RestrictNamespaces=yes

# ── Security: Network ────────────────────────────────────────────────
# configd needs: AF_INET/AF_INET6 (LDAP, listener port 7171),
# AF_UNIX (sd_notify socket, local IPC).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ── Security: System call filtering ──────────────────────────────────
# @system-service covers all syscalls a typical service needs, including
# clone (goroutines), socket, read/write, mmap, etc.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ── Security: Memory restrictions ─────────────────────────────────────
# NOTE: MemoryDenyWriteExecute=yes is DISABLED because child processes
# (zmlocalconfig, zmprov) invoke Java which requires W^X for JIT.
# This is a documented security trade-off for Java compatibility.
#MemoryDenyWriteExecute=yes

# Environment
Environment=TMPDIR=/opt/zextras/data/tmp
Environment=GOMAXPROCS=4
WorkingDirectory=/opt/zextras

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carbonio-configd

[Install]
WantedBy=carbonio-appserver.target carbonio-directory-server.target carbonio-mta.target carbonio-proxy.target
