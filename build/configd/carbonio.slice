# Parent cgroup of the Carbonio service processes that carbonio-configd (and
# `zmcontrol`) start themselves in non-systemd mode, one carbonio-run-*@ unit
# each. `systemd-cgls` shows them under this slice, and `systemctl set-property
# carbonio.slice MemoryMax=...` bounds all of them together. No limit is set
# here: the services have never had one.

[Unit]
Description=Carbonio services started by configd
Documentation=https://docs.zextras.com
